# Copier en prospection/.env et remplir. Ne jamais commiter le fichier réel
# (voir prospection/.gitignore et règle 17 du CLAUDE.md).
# Ce fichier est dédié à prospection/ — ne pas mélanger avec .env.production
# à la racine, qui sert le site principal.

# Pas de ANTHROPIC_API_KEY ici : l'accroche par Haiku a été retirée du
# pipeline de prospection (voir prospection/README.md) — cette clé ne sert
# plus qu'au chatbot du site, dans .env.production à la racine (fichier
# distinct, ne pas mélanger).

# --- Resend (envoi via l'API HTTP, pas le relais SMTP — voir README pour le
# pourquoi : seule l'API renvoie un id exploitable par le circuit-breaker).
# Clé en permission "Full Access", pas "Sending access" seul — une clé
# restreinte à l'envoi ne peut pas lire le statut des emails, ce qui casse
# silencieusement le circuit-breaker (il ne verrait jamais de bounce/plainte). ---
RESEND_API_KEY=re_VOTRE_CLE_API
# quentin@cartwyn.fr : adresse unique harmonisée (From, désabonnement, IMAP
# ci-dessous) — pas contact@cartwyn.fr. RESEND_FROM_NAME = "Cartwyn" (nom de
# marque, pas de personne) : choix assumé du porteur du projet après avoir
# comparé les deux sur un envoi réel — compromis connu sur le classement
# Gmail Promotions, voir README, ne pas rechanger sans qu'il le redemande.
RESEND_FROM_EMAIL=quentin@cartwyn.fr
RESEND_FROM_NAME=Cartwyn

# --- Domaine d'envoi : cartwyn.fr — décision finale (règle 19 du CLAUDE.md).
# Pas de domaine satellite : cartwyn.online a été évalué et écarté (pénalité
# structurelle de son TLD sur les filtres anti-spam, indépendante de toute
# config DNS). Sur cartwyn.fr, Resend publie SPF/DKIM/DMARC directement sur
# le domaine de production (pas de sous-domaine technique séparé comme
# c'était le cas pour l'essai cartwyn.online) — les deux variables ci-dessous
# valent donc la même chose en pratique, gardées séparées dans le code par
# prudence (voir check_domain_auth() dans send_sequence.py).
# cartwyn.fr a déjà un SPF actif pour Hostinger : ne JAMAIS ajouter un
# second enregistrement TXT v=spf1, fusionner l'include: de Resend dans
# celui qui existe déjà. Copier les valeurs exactes affichées dans le
# dashboard Resend, ne jamais les deviner.
SENDING_DOMAIN=cartwyn.fr
ROOT_DOMAIN=cartwyn.fr
DKIM_SELECTOR=resend
UNSUBSCRIBE_ADDRESS=quentin@cartwyn.fr

# --- IMAP (détection des réponses / désabonnements) ---
# Boîte quentin@cartwyn.fr — même adresse que RESEND_FROM_EMAIL et
# UNSUBSCRIBE_ADDRESS ci-dessus (harmonisation volontaire, une seule boîte à
# surveiller). Confirmer dans le hPanel que l'accès IMAP est bien activé
# pour cette boîte (parfois désactivé par défaut) avant de compter dessus.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=quentin@cartwyn.fr
IMAP_PASSWORD=VOTRE_MOT_DE_PASSE_OU_APP_PASSWORD
IMAP_FOLDER=INBOX
