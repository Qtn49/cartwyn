# Formulaire de contact — créer un compte gratuit sur https://formspree.io,
# créer un formulaire, puis coller son endpoint ci-dessous (préfixe
# NEXT_PUBLIC_ obligatoire : la valeur est utilisée côté client).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/VOTRE_ID

# Analytics privacy-friendly — créer un compte gratuit sur
# https://plausible.io, y ajouter le domaine cartwyn.fr, puis renseigner sa
# valeur exacte ci-dessous. Le script n'est chargé que si un visiteur
# accepte les cookies de mesure d'audience via le bandeau RGPD.
NEXT_PUBLIC_ANALYTICS_DOMAIN=cartwyn.fr

# Origine de l'instance Plausible. Laisser vide (ou omettre) pour utiliser
# le cloud https://plausible.io. Sur le serveur de production, mettre
# https://analytics.cartwyn.fr pour utiliser l'instance auto-hébergée.
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# Identifiant de script propre au site, donné par le dashboard Plausible
# self-hosted lors de l'ajout du site cartwyn.fr (bouton "Add snippet" >
# script au format pa-xxxxxxxxxxxxxxxxxxxxx.js). Laisser vide pour le cloud
# Plausible (utilise alors data-domain + script.js générique à la place).
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_ID=

# Clé API Anthropic (jamais préfixée NEXT_PUBLIC_ : utilisée uniquement côté
# serveur dans app/api/chat/route.ts, ne doit jamais atteindre le bundle
# client). Créer une clé sur https://console.anthropic.com.
ANTHROPIC_API_KEY=
