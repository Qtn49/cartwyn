# Formulaire de contact — créer un compte gratuit sur https://formspree.io,
# créer un formulaire, puis coller son endpoint ci-dessous (préfixe
# NEXT_PUBLIC_ obligatoire : la valeur est utilisée côté client).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/VOTRE_ID

# Analytics privacy-friendly — créer un compte gratuit sur
# https://plausible.io, y ajouter le domaine cartwyn.fr, puis renseigner sa
# valeur exacte ci-dessous. Le script n'est chargé que si un visiteur
# accepte les cookies de mesure d'audience via le bandeau RGPD.
NEXT_PUBLIC_ANALYTICS_DOMAIN=cartwyn.fr
